<%- include('../partials/head') %>
<%- include('../partials/adminNav') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <div>
        <h1 class="page__title">จุดวัดระดับน้ำ</h1>
        <p class="page__subtitle">ทั้งหมด <%= pagination.total %> จุดวัด</p>
      </div>
      <div class="page__actions">
        <% if (can('station.create')) { %>
          <a class="btn btn--primary" href="/admin/stations/new">+ สร้างจุดวัดใหม่</a>
        <% } %>
      </div>
    </div>

    <% if (query.created === '1') { %><div class="alert alert--success">สร้างจุดวัดเรียบร้อยแล้ว</div><% } %>
    <% if (query.deleted === '1') { %><div class="alert alert--success">ลบจุดวัดเรียบร้อยแล้ว</div><% } %>

    <form class="filters" method="get" action="/admin/stations">
      <div class="field">
        <label class="field__label" for="search">ค้นหา</label>
        <input class="input input--sm" type="search" id="search" name="search"
               value="<%= filters.search %>" placeholder="ชื่อจุดวัดหรือชื่อย่อ">
      </div>
      <div class="field">
        <label class="field__label" for="status">สถานะ</label>
        <select class="select input--sm" id="status" name="status" data-auto-submit>
          <option value="">ทั้งหมด</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>เปิดใช้งาน</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>ปิดใช้งาน</option>
        </select>
      </div>
      <button class="btn btn--sm btn--primary" type="submit">ค้นหา</button>
      <a class="btn btn--sm" href="/admin/stations">ล้างตัวกรอง</a>
    </form>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>ชื่อจุดวัด</th>
            <th>ชื่อย่อ (URL)</th>
            <th>กล้อง</th>
            <th>สถานะ</th>
            <th class="table__actions">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% if (!stations.length) { %>
            <tr><td colspan="5" class="table__empty">ไม่พบจุดวัดที่ตรงกับเงื่อนไข</td></tr>
          <% } %>
          <% stations.forEach((station) => { %>
            <tr>
              <td>
                <a href="/admin/stations/<%= station.id %>"><strong><%= station.name %></strong></a>
                <% if (station.description) { %>
                  <br><span class="small muted"><%= station.description %></span>
                <% } %>
              </td>
              <td>
                <a class="mono small" href="<%= station.publicPath %>" target="_blank" rel="noopener">
                  <%= station.slug %> ↗
                </a>
              </td>
              <td class="small">
                <span class="badge"><%= station.cameraType %></span>
                <% if (!station.cameraUrl) { %>
                  <span class="badge badge--warning">ยังไม่ตั้งค่า</span>
                <% } %>
              </td>
              <td>
                <% if (station.isActive) { %>
                  <span class="badge badge--success">เปิดใช้งาน</span>
                <% } else { %>
                  <span class="badge">ปิดใช้งาน</span>
                <% } %>
              </td>
              <td class="table__actions">
                <div class="flex" style="justify-content:flex-end">
                  <% if (can('roi.write')) { %>
                    <a class="btn btn--sm" href="/admin/stations/<%= station.id %>/roi">ROI</a>
                  <% } %>
                  <% if (can('calibration.write')) { %>
                    <a class="btn btn--sm" href="/admin/stations/<%= station.id %>/calibration">เทียบค่า</a>
                  <% } %>
                  <% if (can('station.update')) { %>
                    <form method="post" action="/admin/stations/<%= station.id %>/active" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="isActive" value="<%= station.isActive ? '0' : '1' %>">
                      <button class="btn btn--sm" type="submit">
                        <%= station.isActive ? 'ปิดใช้งาน' : 'เปิดใช้งาน' %>
                      </button>
                    </form>
                  <% } %>
                  <% if (can('station.delete')) { %>
                    <form method="post" action="/admin/stations/<%= station.id %>/delete" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn--sm btn--danger" type="submit"
                              data-confirm="ลบจุดวัด &quot;<%= station.name %>&quot; พร้อมค่าวัดและภาพทั้งหมด? การกระทำนี้ย้อนกลับไม่ได้">
                        ลบ
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/pagination') %>
  </div>
</main>

<%- include('../partials/foot') %>
