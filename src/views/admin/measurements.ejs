<%- include('../partials/head') %>
<%- include('../partials/adminNav') %>

<main class="page">
  <div class="container">
    <div class="page__header">
      <div>
        <h1 class="page__title">ค่าวัดระดับน้ำ</h1>
        <p class="page__subtitle">ทั้งหมด <%= pagination.total.toLocaleString('th-TH') %> รายการ</p>
      </div>
      <div class="page__actions">
        <% if (can('measurement.export')) { %>
          <%
          const exportParams = new URLSearchParams(query);
          exportParams.delete('page');
          %>
          <a class="btn" href="/admin/measurements/export?<%= exportParams.toString() %>">
            ⬇ ส่งออก CSV
          </a>
        <% } %>
      </div>
    </div>

    <form class="filters" method="get" action="/admin/measurements">
      <div class="field">
        <label class="field__label" for="stationId">จุดวัด</label>
        <select class="select input--sm" id="stationId" name="stationId" data-auto-submit>
          <option value="">ทุกจุดวัด</option>
          <% stations.forEach((station) => { %>
            <option value="<%= station.id %>"
                    <%= String(query.stationId) === String(station.id) ? 'selected' : '' %>>
              <%= station.name %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="zoneKey">โซน</label>
        <select class="select input--sm" id="zoneKey" name="zoneKey" data-auto-submit>
          <option value="">ทุกโซน</option>
          <% zoneLevels.forEach((zone) => { %>
            <option value="<%= zone.key %>" <%= query.zoneKey === zone.key ? 'selected' : '' %>>
              <%= zone.label %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="from">ตั้งแต่วันที่</label>
        <input class="input input--sm" type="date" id="from" name="from" value="<%= query.from || '' %>">
      </div>
      <div class="field">
        <label class="field__label" for="to">ถึงวันที่</label>
        <input class="input input--sm" type="date" id="to" name="to" value="<%= query.to || '' %>">
      </div>
      <button class="btn btn--sm btn--primary" type="submit">กรอง</button>
      <a class="btn btn--sm" href="/admin/measurements">ล้าง</a>
    </form>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>เวลาที่วัด</th>
            <th class="table__num">พิกเซล</th>
            <th class="table__num">เมตร</th>
            <th>โซน</th>
            <th>ที่มา</th>
            <th>ภาพ</th>
            <% if (can('measurement.delete')) { %><th class="table__actions"></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (!measurements.length) { %>
            <tr><td colspan="7" class="table__empty">ไม่พบค่าวัดที่ตรงกับเงื่อนไข</td></tr>
          <% } %>
          <% measurements.forEach((item) => { %>
            <tr data-measurement-id="<%= item.id %>">
              <td class="nowrap small"><%= formatDateTime(item.measuredAt) %></td>
              <td class="table__num mono">
                <%= item.waterLevelM !== null ? formatNumber(item.waterLevelM) : '—' %>
                  <% if (item.isEstimate) { %>
                    <span class="badge badge--warning" title="ผิวน้ำอยู่ที่ขอบล่างของภาพ — ระดับจริงอาจต่ำกว่านี้">ประมาณ</span>
                  <% } %>
              </td>
              <td><%- include('../partials/zoneBadge', { zone: item.zone }) %></td>
              <td><span class="badge"><%= item.source %></span></td>
              <td>
                <% if (item.thumbnailUrl || item.imageUrl) { %>
                  <a href="<%= item.imageUrl %>" target="_blank" rel="noopener">
                    <img src="<%= item.thumbnailUrl || item.imageUrl %>" alt="ภาพค่าวัด"
                         style="height:2.5rem;border-radius:4px" loading="lazy">
                  </a>
                <% } else { %><span class="faint">—</span><% } %>
              </td>
              <% if (can('measurement.delete')) { %>
                <td class="table__actions">
                  <button class="btn btn--sm btn--danger" type="button" data-delete-measurement
                          data-confirm="ลบค่าวัดรายการนี้?">ลบ</button>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/pagination') %>
  </div>
</main>

<script>
/* ลบค่าวัดผ่าน API แล้วเอาแถวออกจากตารางทันที */
document.querySelectorAll('[data-delete-measurement]').forEach((button) => {
  button.addEventListener('click', async () => {
    const row = button.closest('tr');
    const id = row.dataset.measurementId;
    if (!window.confirm('ลบค่าวัดรายการนี้?')) return;
    try {
      await window.AppShell.api(`/api/admin/measurements/${id}`, { method: 'DELETE' });
      row.remove();
      window.AppShell.toast('ลบค่าวัดแล้ว', 'success');
    } catch (error) {
      window.AppShell.toast(error.message, 'danger');
    }
  });
});
</script>

<%- include('../partials/foot') %>
