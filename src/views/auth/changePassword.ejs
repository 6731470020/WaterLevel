<%- include('../partials/head') %>
<%- include('../partials/adminNav') %>

<main class="page">
  <div class="container container--narrow">
    <div class="page__header">
      <div>
        <h1 class="page__title">เปลี่ยนรหัสผ่าน</h1>
        <p class="page__subtitle">เมื่อเปลี่ยนสำเร็จ อุปกรณ์อื่นทั้งหมดจะถูกออกจากระบบ</p>
      </div>
    </div>

    <% if (required) { %>
      <div class="alert alert--warning">
        ระบบกำหนดให้คุณเปลี่ยนรหัสผ่านก่อนใช้งานส่วนอื่น
      </div>
    <% } %>
    <% if (error) { %><div class="alert alert--danger"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert--success"><%= success %></div><% } %>

    <div class="card">
      <div class="card__body">
        <p class="field__hint mb-2"><%= policy %></p>
        <form method="post" action="/change-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label class="field__label" for="currentPassword">รหัสผ่านเดิม</label>
            <input class="input" type="password" id="currentPassword" name="currentPassword"
                   required autocomplete="current-password">
          </div>
          <div class="field">
            <label class="field__label" for="newPassword">รหัสผ่านใหม่</label>
            <input class="input" type="password" id="newPassword" name="newPassword"
                   required autocomplete="new-password" minlength="10">
          </div>
          <div class="field">
            <label class="field__label" for="confirmPassword">ยืนยันรหัสผ่านใหม่</label>
            <input class="input" type="password" id="confirmPassword" name="confirmPassword"
                   required autocomplete="new-password" minlength="10">
          </div>
          <button class="btn btn--primary" type="submit">บันทึกรหัสผ่านใหม่</button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
