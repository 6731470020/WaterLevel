<%- include('../partials/head', { bodyClass: 'auth-page' }) %>

<main class="auth-card">
  <div class="auth-card__brand">
    <div class="auth-card__logo" aria-hidden="true">🔑</div>
    <h1 class="auth-card__title">ลืมรหัสผ่าน</h1>
    <p class="auth-card__subtitle">กรอกอีเมลที่ใช้กับบัญชีของคุณ</p>
  </div>

  <% if (sent) { %>
    <%
    /* ข้อความนี้แสดงเหมือนกันทุกกรณี ไม่ว่าอีเมลจะมีในระบบหรือไม่
       เพื่อไม่ให้ผู้โจมตีใช้หน้านี้ไล่หาว่าอีเมลใดมีบัญชีอยู่ */
    %>
    <div class="alert alert--success">
      หากอีเมลนี้มีบัญชีอยู่ในระบบ เราได้ส่งลิงก์ตั้งรหัสผ่านใหม่ไปให้แล้ว
      <br><span class="small">ลิงก์มีอายุ 30 นาที และใช้ได้เพียงครั้งเดียว</span>
    </div>
    <a class="btn btn--block" href="/login">กลับหน้าเข้าสู่ระบบ</a>
  <% } else { %>
    <% if (error) { %><div class="alert alert--danger"><%= error %></div><% } %>
    <form method="post" action="/forgot-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="email">อีเมล</label>
        <input class="input" type="email" id="email" name="email" required autofocus autocomplete="email">
      </div>
      <button class="btn btn--primary btn--block" type="submit">ส่งลิงก์ตั้งรหัสผ่านใหม่</button>
    </form>
    <p class="auth-card__links"><a href="/login">กลับหน้าเข้าสู่ระบบ</a></p>
  <% } %>
</main>

<%- include('../partials/foot') %>
