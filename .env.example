# ═══════════════════════════════════════════════════════════
#  ค่าตั้งค่าของระบบวัดระดับน้ำอัตโนมัติ
#
#  ⚙️  ค่าส่วนใหญ่ในไฟล์นี้เป็นเพียง **ค่าตั้งต้น** — ตั้งค่าจริงได้ที่
#      หน้า /admin/settings ซึ่งเก็บลงฐานข้อมูลและมีผลทันทีโดยไม่ต้องรีสตาร์ต
#      ค่าที่ตั้งจากหน้าเว็บชนะค่าในไฟล์นี้เสมอ · ล้างค่าจากหน้าเว็บแล้วจะกลับมาใช้ไฟล์นี้
#
#  🔒 ค่าที่ทำเครื่องหมาย [ไฟล์นี้เท่านั้น] แก้จากหน้าเว็บไม่ได้ เพราะระบบต้องอ่าน
#      ก่อนที่ฐานข้อมูลจะพร้อม หรือเป็นค่าที่ไม่ควรอยู่ในมือผู้ใช้หน้าเว็บ
# ═══════════════════════════════════════════════════════════

# ── แอปพลิเคชัน [ไฟล์นี้เท่านั้น] ─────────────────────────
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
TZ=Asia/Bangkok

# ── ฐานข้อมูล [ไฟล์นี้เท่านั้น] ────────────────────────────
DB_DRIVER=sqlite
DB_FILE=./storage/waterlevel.db
# ใช้เฉพาะเมื่อ DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=waterlevel
DB_PASSWORD=
DB_NAME=waterlevel
DB_CONNECTION_LIMIT=10

# ── Session [ไฟล์นี้เท่านั้น] ──────────────────────────────
# กุญแจเซ็นคุกกี้ — ตั้งจากหน้าเว็บไม่ได้โดยเจตนา เปลี่ยนเมื่อไรทุกคนหลุดจากระบบทันที
# สุ่มอย่างน้อย 32 ตัวอักษร:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── ที่เก็บไฟล์ [ไฟล์นี้เท่านั้น] ────────────────────────────
# ย้ายไปฐานข้อมูลไม่ได้ เพราะพาธของภาพที่บันทึกไว้แล้วอ้างอิงค่านี้
STORAGE_PATH=./storage

# ── งานตามเวลา [ไฟล์นี้เท่านั้น] ────────────────────────────
# ปิดไว้เมื่อรันหลายอินสแตนซ์แล้วต้องการให้มีตัวเดียวที่ทำงานตามเวลา
SCHEDULER_ENABLED=true

# ── ด่านกัน SSRF [ไฟล์นี้เท่านั้น] ──────────────────────────
# ปกติ URL กล้องห้ามชี้ไปยังเครือข่ายภายใน (10.* / 172.16-31.* / 192.168.* / 127.* / 169.254.*)
# เปิดเป็น true ได้เมื่อกล้องอยู่ในวงแลนเดียวกับเซิร์ฟเวอร์จริง ๆ เท่านั้น
#
# จงใจไม่ให้ตั้งจากหน้าเว็บ — สวิตช์ที่ปิดแล้วเปิดทางยิงคำขอเข้าเครือข่ายภายใน
# ไม่ควรอยู่ในฟอร์มที่กดพลาดได้ การแก้ไฟล์นี้บนเซิร์ฟเวอร์เป็นการกระทำที่ตั้งใจกว่า
ALLOW_PRIVATE_CAMERA_URL=false


# ═══════════════════════════════════════════════════════════
#  ต่อจากนี้เป็น **ค่าตั้งต้น** — ตั้งจริงที่ /admin/settings
# ═══════════════════════════════════════════════════════════

# ── บริการตรวจจับด้วย AI · แท็บ "บริการตรวจจับ" ────────────
DETECTION_DRIVER=mock
WATER_API_URL=
WATER_API_KEY=
DETECTION_TIMEOUT_MS=30000

# คีย์ข้างบนนี้ *คือ* ใบอนุญาตของระบบในตัวมันเอง — มีวันหมดอายุติดมากับคีย์
# ระบบถามสถานะจาก GET {WATER_API_URL}/key-info เป็นรอบ แล้วอัปเดตวันหมดอายุให้เอง
# คีย์หมดอายุเมื่อไร บริการตรวจจับก็ปฏิเสธคำขอทันที ระบบจึงทำงานต่อไม่ได้อยู่แล้ว

# ── ช่องทางแจ้งเตือน · แท็บ "ช่องทางแจ้งเตือน" ──────────────
# ใส่ได้หลายค่าคั่นด้วยจุลภาค เช่น line,discord,telegram — ส่งพร้อมกันทุกช่องทาง
# console = พิมพ์ลงคอนโซลเฉย ๆ (ใช้ตอนพัฒนา ไม่ยิงข้อความจริง)
NOTIFICATION_DRIVER=console

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_DEFAULT_GROUP_ID=

# สร้างที่ ตั้งค่าช่อง → Integrations → Webhooks → คัดลอก URL
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=ระบบวัดระดับน้ำ

# ขอโทเคนจาก @BotFather แล้วเชิญบอทเข้ากลุ่ม
# หา TELEGRAM_CHAT_ID จาก https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── การวัดและข้อมูล · แท็บ "การวัดและข้อมูล" ────────────────
MAX_VARIATION_PX=50
CONFIRMATION_ATTEMPTS=3
CONFIRMATION_DELAY_SEC=10
CONSISTENCY_THRESHOLD_PX=25
IMAGE_RETENTION_DAYS=90

# ── ตารางเวลา · แท็บ "ตารางเวลา" ───────────────────────────
SCHEDULE_DETECT=*/5 * * * *
SCHEDULE_DAILY_REPORT=0 18 * * *
SCHEDULE_RETENTION=0 3 * * *
SCHEDULE_HEALTH_CHECK=*/15 * * * *
SCHEDULE_LICENSE_SYNC=7 */6 * * *
HEALTH_STALE_MINUTES=30

# ── ความปลอดภัย · แท็บ "ความปลอดภัย" ──────────────────────
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_MAX_AGE_HOURS=8
SESSION_IDLE_TIMEOUT_HOURS=2

# ── อีเมล (ลืมรหัสผ่าน) · แท็บ "อีเมล" ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.go.th
